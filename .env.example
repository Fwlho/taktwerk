# Vorlage – echte Werte nur in .env.local (wird nie eingecheckt)

# Supabase (Projekt in Region Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Adresse der App (lokal: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# KI (Phase 3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Web-Push (erzeugen mit: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
