# Vorlage – echte Werte nur in .env.local (wird nie eingecheckt)

# Supabase (Projekt in Region Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Adresse der App (lokal: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# KI (Phase 3) – Schlüssel aus der Anthropic-Konsole; leer = KI aus (Kampagnen dann aus Branchenvorlagen)
ANTHROPIC_API_KEY=
# leer = claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# nur für Tests: AI_FAKE=1 liefert feste Beispieltexte ohne Kosten

# Web-Push (erzeugen mit: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
